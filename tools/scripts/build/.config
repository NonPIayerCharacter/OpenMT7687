OS_VERSION := $(shell uname)

GCC_VERSION ?= 4.8.4
ifeq ($(IOT_SDK_GCC_VER), V9)
    GCC_VERSION := 9.2.1
endif

#$(info GCC_VERSION : $(GCC_VERSION))
CROSS_COMPILE :=
ifneq ($(filter MINGW% MSYS%,$(OS_VERSION)),)
  CROSS_COMPILE := win
else
  CROSS_COMPILE := linux
  # backward compatible, will be phased out in the future.
  ifeq ($(wildcard $(SOURCE_DIR)/tools/gcc$(GCC_VERSION)/$(CROSS_COMPILE)/gcc-arm-none-eabi/bin),)
    CROSS_COMPILE :=
  endif
endif

BINPATH = $(SOURCE_DIR)/tools/gcc$(GCC_VERSION)/$(CROSS_COMPILE)/gcc-arm-none-eabi/bin
ifeq ($(wildcard $(BINPATH)),)
    $(error Gcc toolchain tools/gcc$(GCC_VERSION)/$(CROSS_COMPILE)/gcc-arm-none-eabi/bin not exist!!)
endif
#$(info BINPATH : $(BINPATH))
ERR_LOG	= $(OUTPATH)/err.log
BUILD_LOG = $(OUTPATH)/build.log

ifeq ($(BUILD_TYPE), boot_loader)
LD_FILES = xxx.ld
endif
ifeq ($(BUILD_TYPE), rtos_wo_fota)
LD_FILES = flash.ld
endif
ifeq ($(BUILD_TYPE), rtos_full_fota)
LD_FILES = flash.ld
endif
ifeq ($(BUILD_TYPE), rtos_separate_fota)
LD_FILES = flash.ld
SEPARATE_BUILD=1
SEPARATE_MBIN_LD=flash_mbin.ld
SEPARATE_UBIN_LD=flash_ubin.ld
endif
ifeq ($(BUILD_TYPE), ram_debug)
LD_FILES = ram.ld
endif

